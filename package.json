{
  "name": "student-reviewer-backend",
  "version": "0.1.0",
  "description": "Document-Based Student Reviewer System - REST API (Express + MySQL)",
  "main": "backend/src/server.js",
  "scripts": {
    "start": "node backend/src/server.js",
    "go": "npm run setup && npm run dev",
    "setup": "node backend/scripts/setup.js && npm run db:init",
    "postinstall": "npm install --prefix frontend",
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch backend/src/server.js",
    "dev:client": "npm run dev --prefix frontend",
    "db:init": "node backend/database/init.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.9.7"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}